{
	"name": "pi-web-search-lite",
	"version": "0.10.0",
	"description": "Pi extension: lightweight web_search + web_fetch with configurable search provider and fetch chain.",
	"author": "setwhite",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/setwhite/pi-extensions.git",
		"directory": "packages/pi-web-search-lite"
	},
	"homepage": "https://github.com/setwhite/pi-extensions/tree/main/packages/pi-web-search-lite#readme",
	"bugs": {
		"url": "https://github.com/setwhite/pi-extensions/issues"
	},
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"src"
	],
	"keywords": [
		"pi-package",
		"pi-extension",
		"web-search",
		"web-fetch",
		"tavily",
		"brave",
		"exa",
		"firecrawl",
		"perplexity",
		"parallel",
		"keenable",
		"deepseek",
		"jina"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"check:imports": "node ../../scripts/check-imports.mjs",
		"test": "vitest run",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@earendil-works/pi-coding-agent": "^1.1.0",
		"@earendil-works/pi-tui": "^1.1.0",
		"@types/node": "^26.6.4",
		"typebox": "^1.3.36",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"undici": "8.12.3"
	}
}
