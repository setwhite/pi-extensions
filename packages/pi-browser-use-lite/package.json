{
	"name": "pi-browser-use-lite",
	"version": "0.1.0",
	"description": "Pi extension: drive your own Chrome through a companion browser extension.",
	"keywords": ["pi-package", "pi-extension", "chrome", "browser"],
	"type": "module",
	"license": "MIT",
	"author": "setwhite",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/setwhite/pi-extensions.git",
		"directory": "packages/pi-browser-use-lite"
	},
	"packageManager": "pnpm@12.3.4",
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"scripts": {
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"check:imports": "node ../../scripts/check-imports.mjs",
		"test": "vitest run",
		"test:e2e": "vitest run --config vitest.e2e.config.ts",
		"typecheck": "tsc --noEmit"
	},
	"files": ["src", "browser-extension", "CHANGELOG.md"],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@earendil-works/pi-tui": "^1.4.0",
		"@types/node": "^26.6.5",
		"typebox": "^1.4.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
