{
	"name": "pi-extensions",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"lint": "pnpm -r --no-bail lint",
		"check:imports": "pnpm -r --no-bail check:imports",
		"typecheck": "pnpm -r --no-bail typecheck",
		"test": "pnpm -r --no-bail test",
		"check": "pnpm lint && pnpm check:imports && pnpm typecheck && pnpm test"
	}
}
